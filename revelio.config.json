{
  "defaults": {
    "outputDir": null,
    "severityThreshold": "high",
    "failOnFindings": true,
    "failOnScannerErrors": true,
    "deepScan": false,
    "allowNetworkQueries": true,
    "osvBatchSize": 200,
    "osvDetailDelay": 0.1,
    "retainRuns": 0
  },
  "inventory": {
    "homebrew": true,
    "npmGlobal": true,
    "pythonPip": true,
    "pipx": true,
    "uvTools": true,
    "cargo": true,
    "rubyGems": true,
    "rubyGemsExcludeSystem": true,
    "goTools": true,
    "dotnetTools": true,
    "dpkg": true,
    "rpm": true,
    "pacman": true,
    "snap": true,
    "flatpak": true
  },
  "scanners": {
    "outdatedChecks": true,
    "osv": true,
    "npmAudit": true,
    "npmReleaseChannelChecks": true,
    "pipAudit": true,
    "cargoAudit": true,
    "grype": true,
    "grypeTargets": [
      "/opt/homebrew/Cellar",
      "/usr/local/Cellar",
      "/home/linuxbrew/.linuxbrew/Cellar",
      "~/.linuxbrew/Cellar",
      "~/.npm-global/lib/node_modules",
      "~/.local/pipx/venvs",
      "~/.local/share/pipx/venvs",
      "~/.cargo/bin",
      "~/go/bin",
      "/var/lib/dpkg",
      "/var/lib/rpm",
      "/var/lib/pacman/local",
      "/var/lib/snapd",
      "/var/lib/flatpak"
    ],
    "grypeDeepTargets": [
      "/Applications",
      "~/Applications",
      "/usr/local",
      "/opt",
      "~/.local",
      "/var/lib/flatpak/app",
      "~/.local/share/flatpak/app",
      "/snap"
    ]
  },
  "publish": {
    "enabled": false,
    "repoUrl": "",
    "branch": "main",
    "pathTemplate": "reports/{hostname}/{run-id}/",
    "commitMessageTemplate": "chore(revelio): scan {run-id} on {hostname}",
    "tokenEnvVar": "REVELIO_GIT_TOKEN"
  }
}
